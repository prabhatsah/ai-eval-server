generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Role {
  MANAGER
  CANDIDATE
}

enum AssessmentStatus {
  PENDING_REVIEW
  APPROVED
  NEEDS_REVISION
  REJECTED
  REVIEW_FAILED
}

enum CandidateAssessmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  EXPIRED
  CANCELLED
}

// USER
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  skills          Json?
  experienceYears Float?
  currentRole     String?

  overallSkillScores     Json?
  overallAssessmentScore Float?

  refreshToken String?

  jobDescriptions             JobDescription[]
  assessments                 Assessment[]
  candidateAssessments        CandidateAssessment[] @relation("CandidateAssessments")
  createdCandidateAssessments CandidateAssessment[] @relation("CreatedCandidateAssessments")
}

// EVALUATION
// model Evaluation {
//   id        String   @id @default(uuid())
//   title     String
//   skill     String
//   config    Json
//   createdBy String
//   createdAt DateTime @default(now())

//   candidateAssessment CandidateAssessment[]
// }

// JOB DESCRIPTION (VERSIONED)
model JobDescription {
  id String @id @default(uuid())

  // Logical grouping (same JD across versions)
  jdGroupId String

  // Versioning
  version Int

  // Raw input
  rawText String

  // Parsed structured data
  role            String
  primarySkills   Json
  secondarySkills Json?
  experienceYears Int?
  difficulty      Difficulty
  focusAreas      Json?

  isLatest Boolean @default(true)

  // Creator relation
  createdById String
  creator     User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATION
  assessments Assessment[]

  @@unique([jdGroupId, version]) // prevents duplicate versions
  @@index([jdGroupId])
  @@index([isLatest])
}

// ASSESSMENT (SNAPSHOT OF JD VERSION)
model Assessment {
  id String @id @default(uuid())

  assessmentCode String @unique

  jobDescriptionId String
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id])

  // SNAPSHOT (IMPORTANT)
  role            String
  difficulty      Difficulty
  experienceYears Int?

  mcqCount    Int
  codingCount Int

  durationMinutes Int?

  primarySkills   Json
  secondarySkills Json?
  focusAreas      Json?

  status               AssessmentStatus @default(PENDING_REVIEW)
  reviewScore          Int?
  reviewRecommendation String?
  reviewIssues         Json?
  reviewedAt           DateTime?

  // Creator relation
  createdById String
  creator     User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS
  mcqs                 McqQuestion[]
  codingQuestions      CodingQuestion[]
  candidateAssessments CandidateAssessment[]

  @@index([role])
  @@index([difficulty])
  @@index([status])
  @@index([reviewScore])
}

// MCQ QUESTIONS
model McqQuestion {
  id String @id @default(uuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  question String
  skills   Json

  options            Json
  correctAnswerIndex Int

  difficulty  Difficulty
  explanation String?

  createdAt DateTime @default(now())

  @@index([assessmentId])
}

// CODING QUESTIONS
model CodingQuestion {
  id String @id @default(uuid())

  title   String
  problem String

  constraints String?

  sampleCases Json

  hiddenTestCases Json

  expectedApproach String?

  timeComplexity  String?
  spaceComplexity String?

  difficulty Difficulty

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])
  assessmentId String?
}

// CANDIDATE ASSESSMENT
model CandidateAssessment {
  id String @id @default(uuid())

  // Existing candidate relation
  candidateId String
  candidate   User   @relation("CandidateAssessments", fields: [candidateId], references: [id])

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  status CandidateAssessmentStatus @default(ASSIGNED)

  mcqScore    Float?
  codingScore Float?
  aiScore     Float?
  finalScore  Float?

  skillBreakdown Json?

  startedAt   DateTime?
  submittedAt DateTime?
  evaluatedAt DateTime?
  expiresAt   DateTime?

  evaluationSummary String?
  feedback          Json?

  // Creator relation
  createdById String
  createdBy   User   @relation("CreatedCandidateAssessments", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses    Response[]
  // evaluation   Evaluation? @relation(fields: [evaluationId], references: [id])
  evaluationId String?

  @@unique([candidateId, assessmentId])
  @@index([candidateId])
  @@index([assessmentId])
  @@index([status])
  @@index([finalScore])
}

// RESPONSE
model Response {
  id String @id @default(uuid())

  candidateAssessmentId String
  candidateAssessment   CandidateAssessment @relation(fields: [candidateAssessmentId], references: [id])

  mcqQuestionId    String?
  codingQuestionId String?

  selectedOptionIndex Int?

  codingAnswer String?

  isCorrect  Boolean?
  score      Float?
  aiFeedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateAssessmentId, mcqQuestionId])
  @@unique([candidateAssessmentId, codingQuestionId])
  @@index([candidateAssessmentId])
  @@index([mcqQuestionId])
  @@index([codingQuestionId])
}
