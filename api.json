  "info": {
    "title": "AI Evaluation API",
    "description": "API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SignupDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "example": "test@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "StrongPass123"
          },
          "role": {
            "type": "string",
            "enum": [
              "MANAGER",
              "CANDIDATE"
            ],
            "example": "MANAGER"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "role"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "test@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "StrongPass123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "uuid-string"
          },
          "name": {
            "type": "string",
            "example": "Prabhat Kumar"
          },
          "email": {
            "type": "string",
            "example": "prabhat@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "MANAGER",
              "CANDIDATE"
            ],
            "example": "MANAGER"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2025-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "createdAt"
        ]
      },
      "JdResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "primarySkills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "secondarySkills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "EASY",
              "MEDIUM",
              "HARD"
            ]
          },
          "experienceYears": {
            "type": "number"
          },
          "focusAreas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "role",
          "primarySkills",
          "difficulty"
        ]
      },
      "CreateAssessmentDto": {
        "type": "object",
        "properties": {
          "jdId": {
            "type": "string",
            "example": "1203e303-762a-4a36-8271-b2f43ba83991"
          },
          "mcqCount": {
            "type": "number",
            "example": 10
          },
          "codingCount": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "jdId",
          "mcqCount",
          "codingCount"
        ]
      },
      "StartAssessmentDto": {
        "type": "object",
        "properties": {
          "candidateAssessmentId": {
            "type": "string",
            "example": "1203e303-762a-4a36-8271-b2f43ba83991"
          }
        },
        "required": [
          "candidateAssessmentId"
        ]
      },
      "McqAnswerDto": {
        "type": "object",
        "properties": {
          "mcqQuestionId": {
            "type": "string"
          },
          "selectedOptionIndex": {
            "type": "number",
            "minimum": -1,
            "maximum": 3,
            "example": 1
          }
        },
        "required": [
          "mcqQuestionId",
          "selectedOptionIndex"
        ]
      },
      "SubmitAssessmentDto": {
        "type": "object",
        "properties": {
          "candidateAssessmentId": {
            "type": "string"
          },
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/McqAnswerDto"
            }
          }
        },
        "required": [
          "candidateAssessmentId",
          "answers"
        ]
      },
      "AssignAssessmentDto": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "example": "1203e303-762a-4a36-8271-b2f43ba83991"
          },
          "assessmentId": {
            "type": "string",
            "example": "4000eced-68f1-42ba-bee7-7cf4e818eb52"
          },
          "expiresAt": {
            "type": "string",
            "example": "2026-06-01T12:00:00.000Z"
          }
        },
        "required": [
          "candidateId",
          "assessmentId"
        ]
      }
    }
  }
}