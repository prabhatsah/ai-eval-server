    "/jd": {
      "post": {
        "description": "Parses a raw JD and stores structured data in database",
        "operationId": "JdController_parseJd",
        "parameters": [
          {
            "name": "x-llm-provider",
            "required": true,
            "in": "header",
            "description": "LLM Provider [ gemini | openai ]",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-api-key",
            "required": true,
            "in": "header",
            "description": "Your Api Key",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JdResponseDto"
                }
              }
            }
          }
        },
        "summary": "Parse a job description",
        "tags": [
          "Job Description"
        ]
      },
      "get": {
        "operationId": "JdController_getAll",
        "parameters": [],
        "responses": {
